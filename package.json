{
  "name": "ecodrix",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --config-path=biome.json .",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "pnpm build && tsx scripts/analyze-bundle.ts",
    "format": "biome format --config-path=biome.json --write .",
    "check": "biome check --config-path=biome.json ."
  },
  "dependencies": {
    "@ecodrix/erix-api": "^1.3.4",
    "@ecodrix/erix-editor": "^1.2.0",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "next": "16.2.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-phone-number-input": "^3.4.16",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.2",
    "@biomejs/biome": "2.5.15"
  }
}
