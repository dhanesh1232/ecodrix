# ecodrix.com (marketing site) — every env var the site reads. Copy to .env.local
# for local work. Nothing is required: both default to https://api.ecodrix.com.

# API base for server-rendered pages (blog, ISR). Local stack: http://localhost:4000
API_URL=
# API base for the browser (visit tracking, waitlist, newsletter, status page,
# pricing). Despite the name it is the REST API, not a socket.
NEXT_PUBLIC_ERIX_SOCKET_URL=
